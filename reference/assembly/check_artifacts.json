{
  "_comment": "Exact-boolean disjointness proofs for the 5 KNOWN-ARTIFACT contact pairs (see check_asm.py KNOWN_TESSELLATION_ARTIFACTS and FRICTION.md #19): the housing base's exact adaptive tessellation is currently LEAKY (post-Wave-5 triangulator), and its crack triangles cross two corner insert pockets and three web bores, so the mesh-distance contact scan reads a phantom 0.0 there. The EXACT planar-arrangement boolean is the truth channel: each pair below is posed with the new `pose` op (the .lmcasm pose verbatim), unioned with the base, and `assert`-ed to keep 2 shells — the machine-checkable proof the bodies are disjoint. If any pair ever truly touches, this program exits 1 and run_all.sh fails. Run from the repository root with --out-dir . (load_part inputs resolve against --out-dir, and the part paths here are repo-root-relative).",
  "ops": [
    {"id": "base", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/housing_base.lmcpart"},

    {"id": "bolt0", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/screw_m4x12.lmcpart"},
    {"id": "bolt0_posed", "op": "pose", "in": "bolt0", "translate": [-30.0, -16.0, 82.2]},
    {"id": "u_bolt0", "op": "union", "a": "base", "b": "bolt0_posed"},
    {"id": "disjoint_bolt0", "op": "assert", "in": "u_bolt0", "shells": 2},

    {"id": "bolt3", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/screw_m4x12.lmcpart"},
    {"id": "bolt3_posed", "op": "pose", "in": "bolt3", "translate": [-30.0, 54.0, 82.2]},
    {"id": "u_bolt3", "op": "union", "a": "base", "b": "bolt3_posed"},
    {"id": "disjoint_bolt3", "op": "assert", "in": "u_bolt3", "shells": 2},

    {"id": "spacer9", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/spacer_9.lmcpart"},
    {"id": "spacer9_posed", "op": "pose", "in": "spacer9",
      "rotate": {"axis": [1.0, 0.0, 0.0], "degrees": -90.0}, "translate": [0.0, -3.0, 48.0]},
    {"id": "u_spacer9", "op": "union", "a": "base", "b": "spacer9_posed"},
    {"id": "disjoint_spacer9", "op": "assert", "in": "u_spacer9", "shells": 2},

    {"id": "spacer10", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/spacer_10.lmcpart"},
    {"id": "spacer10_posed", "op": "pose", "in": "spacer10",
      "rotate": {"axis": [1.0, 0.0, 0.0], "degrees": -90.0}, "translate": [45.15, -3.0, 48.0]},
    {"id": "u_spacer10", "op": "union", "a": "base", "b": "spacer10_posed"},
    {"id": "disjoint_spacer10", "op": "assert", "in": "u_spacer10", "shells": 2},

    {"id": "spacer21", "op": "load_part", "file": "crates/kernel-model/tests/fixtures/pre_w6_parts/spacer_21.lmcpart"},
    {"id": "spacer21_posed", "op": "pose", "in": "spacer21",
      "rotate": {"axis": [1.0, 0.0, 0.0], "degrees": -90.0}, "translate": [90.3, -3.0, 48.0]},
    {"id": "u_spacer21", "op": "union", "a": "base", "b": "spacer21_posed"},
    {"id": "disjoint_spacer21", "op": "assert", "in": "u_spacer21", "shells": 2}
  ]

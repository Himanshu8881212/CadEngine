ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('FreeCAD-style full sphere: ONE spherical face bounded by a seam meridian traversed twice between two pole vertices'),'2;1');
FILE_NAME('fc_sphere_ball.step','2026-06-10T12:00:00',('LMCAD corpus'),('LMCAD'),'hand-authored in the Open CASCADE / FreeCAD exporter style','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('fc_sphere_ball','fc_sphere_ball','',(#3));
#5 = PRODUCT_DEFINITION_FORMATION('','',#4);
#6 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7 = PRODUCT_DEFINITION('design','',#5,#6);
#8 = PRODUCT_DEFINITION_SHAPE('','',#7);
#9 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#10 = DIRECTION('',(0.0,0.0,1.0));
#11 = DIRECTION('',(1.0,0.0,0.0));
#12 = AXIS2_PLACEMENT_3D('',#9,#10,#11);
#13 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#14 = DIRECTION('',(0.0,-1.0,0.0));
#15 = DIRECTION('',(1.0,0.0,0.0));
#16 = AXIS2_PLACEMENT_3D('',#13,#14,#15);
#17 = CIRCLE('',#16,10.0);
#18 = CARTESIAN_POINT('',(0.0,0.0,-10.0));
#19 = VERTEX_POINT('',#18);
#20 = CARTESIAN_POINT('',(0.0,0.0,10.0));
#21 = VERTEX_POINT('',#20);
#22 = EDGE_CURVE('',#19,#21,#17,.T.);
#23 = ORIENTED_EDGE('',*,*,#22,.T.);
#24 = ORIENTED_EDGE('',*,*,#22,.F.);
#25 = EDGE_LOOP('',(#23,#24));
#26 = SPHERICAL_SURFACE('',#12,10.0);
#27 = FACE_BOUND('',#25,.T.);
#28 = ADVANCED_FACE('',(#27),#26,.T.);
#29 = CLOSED_SHELL('',(#28));
#30 = MANIFOLD_SOLID_BREP('ball',#29);
#31 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#32 = DIRECTION('',(0.0,0.0,1.0));
#33 = DIRECTION('',(1.0,0.0,0.0));
#34 = AXIS2_PLACEMENT_3D('',#31,#32,#33);
#35 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#36 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#37 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#38 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#35,'distance_accuracy_value','confusion accuracy');
#39 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#38)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#35,#36,#37)) REPRESENTATION_CONTEXT('Context #1','3D Context with UNIT and UNCERTAINTY') );
#40 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#34,#30),#39);
#41 = SHAPE_DEFINITION_REPRESENTATION(#8,#40);
#42 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#4));
ENDSEC;
END-ISO-10303-21;

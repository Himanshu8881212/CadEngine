ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('FreeCAD-style full torus: ONE toroidal face bounded by its two seams (outer equator + tube circle), each traversed twice'),'2;1');
FILE_NAME('fc_torus_ring.step','2026-06-10T12:00:00',('LMCAD corpus'),('LMCAD'),'hand-authored in the Open CASCADE / FreeCAD exporter style','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('fc_torus_ring','fc_torus_ring','',(#3));
#5 = PRODUCT_DEFINITION_FORMATION('','',#4);
#6 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7 = PRODUCT_DEFINITION('design','',#5,#6);
#8 = PRODUCT_DEFINITION_SHAPE('','',#7);
#9 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#10 = DIRECTION('',(0.0,0.0,1.0));
#11 = DIRECTION('',(1.0,0.0,0.0));
#12 = AXIS2_PLACEMENT_3D('',#9,#10,#11);
#13 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#14 = DIRECTION('',(0.0,0.0,1.0));
#15 = DIRECTION('',(1.0,0.0,0.0));
#16 = AXIS2_PLACEMENT_3D('',#13,#14,#15);
#17 = CIRCLE('',#16,10.5);
#18 = CARTESIAN_POINT('',(10.5,0.0,0.0));
#19 = VERTEX_POINT('',#18);
#20 = EDGE_CURVE('',#19,#19,#17,.T.);
#21 = CARTESIAN_POINT('',(8.0,0.0,0.0));
#22 = DIRECTION('',(0.0,-1.0,0.0));
#23 = DIRECTION('',(1.0,0.0,0.0));
#24 = AXIS2_PLACEMENT_3D('',#21,#22,#23);
#25 = CIRCLE('',#24,2.5);
#26 = EDGE_CURVE('',#19,#19,#25,.T.);
#27 = ORIENTED_EDGE('',*,*,#20,.T.);
#28 = ORIENTED_EDGE('',*,*,#26,.T.);
#29 = ORIENTED_EDGE('',*,*,#20,.F.);
#30 = ORIENTED_EDGE('',*,*,#26,.F.);
#31 = EDGE_LOOP('',(#27,#28,#29,#30));
#32 = TOROIDAL_SURFACE('',#12,8.0,2.5);
#33 = FACE_BOUND('',#31,.T.);
#34 = ADVANCED_FACE('',(#33),#32,.T.);
#35 = CLOSED_SHELL('',(#34));
#36 = MANIFOLD_SOLID_BREP('torus',#35);
#37 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#38 = DIRECTION('',(0.0,0.0,1.0));
#39 = DIRECTION('',(1.0,0.0,0.0));
#40 = AXIS2_PLACEMENT_3D('',#37,#38,#39);
#41 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#42 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#43 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#44 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#41,'distance_accuracy_value','confusion accuracy');
#45 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#44)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#41,#42,#43)) REPRESENTATION_CONTEXT('Context #1','3D Context with UNIT and UNCERTAINTY') );
#46 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#40,#36),#45);
#47 = SHAPE_DEFINITION_REPRESENTATION(#8,#46);
#48 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#4));
ENDSEC;
END-ISO-10303-21;
